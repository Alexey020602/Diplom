@typeparam TItem where TItem : class, IEquatable<TItem>
@inherits RadzenDropDown<TItem>

@{
    base.BuildRenderTree(__builder);
}

@code {
    [Parameter] public Func<Task<IReadOnlyList<TItem>>> LoadItems { get; set; } = null!;

    protected override async Task OnParametersSetAsync()
    {
        if (LoadItems == null) throw new Exception("Не задан делегат для загрузки элементов");
        AllowClear = true;
        AllowFiltering = true;
        Data = await LoadItems();
        ItemComparer = new RadzenDropDownEqualityComparer<TItem>();
        await base.OnParametersSetAsync();
    }
}