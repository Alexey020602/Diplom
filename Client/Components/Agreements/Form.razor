@using Client.Services.Api
@using Client.Shared.Select
@using Client.Shared.Text
@using Microsoft.AspNetCore.Components.Forms
@using Model
@using Model.Agreements
@using Model.Divisions
@using Model.Partners
@inherits Client.Shared.Form.BaseForm<Agreement>
@inject IDivisionsForAgreementService DivisionsForAgreementService
@inject IPartnersForAgreementService PartnersForAgreementService

@{
    base.BuildRenderTree(__builder);
}

@code {
    private List<DivisionInAgreement> divisions = [];
    private List<PartnerInAgreement> partners = [];
    [Inject] private IPartnersService PartnersService { get; set; } = null!;
    [Inject] private IDivisionsService DivisionsService { get; set; } = null!;

    protected override RenderFragment Content => @<RadzenStack Orientation=@Orientation.Vertical>
        @Number
        @Type
        @Status
        @Start
        @End
        @Partners
        @Divisions
    </RadzenStack>;

    private RenderFragment Number => FormRow(
        "Номер соглашения",
        "Number",
        @<RadzenTextBox @bind-Value=@Item.Number Name="Number" Placeholder="Номер соглашения"/>
    );

    private RenderFragment Type => FormRow(
        "Тип соглашения",
        "Type",
        @<UniversalCustomSelect
             Name="Type"
             @bind-Value="@Item.Type"/>
    );

    private RenderFragment Status => FormRow(
        "Статус соглашения",
        "Status",
        @<UniversalCustomSelect
             Name="Status"
             @bind-Value="@Item.Status"/>
    );

    private RenderFragment Start => FormRow(
        "Начало",
        "Start",
        @<RadzenDatePicker 
             TValue=@(DateOnly) 
             Value=@Item.Start 
             ShowTime=false
             Change=@(start => Item.Start = DateOnly.FromDateTime(start ?? DateTime.Today)) 
             Name="Start"/>
    );

    private RenderFragment End => FormRow(
        "Конец",
        "End",
        @<RadzenDatePicker 
             TValue=@(DateOnly)
             ShowTime=false
             Value=@Item.End
             Change=@(end => Item.End = DateOnly.FromDateTime(end ?? DateTime.Today))
             Name="End"/>
    );

    private RenderFragment Divisions => @<UniversalCustomMultipleSelectWithText 
                                             TBaseItem=@PartnerShort
                                             TItem=@PartnerInAgreement
                                             Convert=@ConvertPartner
                                             Selected=@Item.Partners
                                             LoadItems="@(() => PartnersForAgreementService.GetPartners() )"
                                             />;
    private RenderFragment Partners => @<UniversalCustomMultipleSelectWithText 
                                            TBaseItem=@DivisionShort
                                            TItem=@DivisionInAgreement
                                            Convert=@ConvertDivision
                                            Selected=@Item.Divisions
                                            LoadItems="@(() => DivisionsForAgreementService.GetDivisions())"
                                        />;

    protected override async Task OnParametersSetAsync()
    {
            await Task.WhenAll(
                LoadDivisions(),
                LoadPartners()
            );

        await base.OnParametersSetAsync();
    }

    private async Task LoadDivisions()
    {
        divisions = await DivisionsForAgreementService.GetDivisions();
    }

    private async Task LoadPartners()
    {
        partners = await PartnersForAgreementService.GetPartners();
    }

    private static PartnerInAgreement ConvertPartner(PartnerShort partner) => new()
    {
Id = partner.Id,
Name = partner.Name
    };

    private static DivisionInAgreement ConvertDivision(DivisionShort division) => new()
    {
Id = division.Id, 
Description = division.Name,
    };

}