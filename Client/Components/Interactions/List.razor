@attribute [Authorize(Roles = "Cip")]
@using Client.Services.Api
@using Microsoft.AspNetCore.Authorization
@using Model
@using Model.Interactions
@using Client.Shared.Select
@inherits Client.Shared.List.SearchableStyledList<InteractionShort>

@page "/interactions"

@{
    base.BuildRenderTree(__builder);
}

@code {
    [Inject] private IInteractionsService InteractionService { get; set; } = null!;
    private InteractionType? interactionType;
    private DateTime? sign;
    private DateTime? start;
    private DateTime? end;
    
    private DateOnly? Sign => sign.HasValue ?  DateOnly.FromDateTime(sign.Value) : null;
    private DateOnly? Start => start.HasValue ? DateOnly.FromDateTime(start.Value) : null;
    private DateOnly? End => end.HasValue ? DateOnly.FromDateTime(end.Value) : null; 
    
    protected override Task<Paging<InteractionShort>> Load(string? text, int? skip, int? take)
    {
        return InteractionService.ReadAll(new InteractionsFilter(
            Code: text,
            InteractionTypeId: interactionType?.Id,
            Sign: Sign,
            Start: Start,
            End: End,
            Skip: skip,
            Take: take));
    }

    protected override string CreateHref => "/interactions/create";
    protected override string CreateText => "Добавить взаимодействие";


    protected override string RowHref(InteractionShort item)
    {
        return $"/interactions/{item.Id}";
    }

    protected override RenderFragment Filters => @<div>
        <UniversalCustomSelect
            Placeholder="Выберите тип партнера"
            TItem=@InteractionType        @bind-Value=@interactionType/>
        <RadzenDatePicker
            Placeholder="Дата подписания"
            @bind-Value=@sign
            TValue="DateTime?"
        />
        <RadzenDatePicker
            Placeholder="Дата начала"
            @bind-Value=@start
            TValue="DateTime?"
        />
    <RadzenDatePicker
        Placeholder="Дата окончания"
        @bind-Value=@end
        TValue="DateTime?"
    />
    </div>;

    protected override string NameFilterTitle => "Введите код";

    protected override void ClearFilterFields()
    {
        interactionType = null;
        sign = null;
        start = null;
        end = null;
    }

}