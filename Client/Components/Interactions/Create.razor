@page "/interactions/Create"
@using Client.Services.Api
@using Microsoft.AspNetCore.Authorization
@using Model.Interactions
@inject IInteractionsService InteractionService
@attribute [Authorize(Roles = "Ctt")]

<Form Item="@interaction" OnSubmit="@OnSubmit" Title="Создание взаимодействия"></Form>

@code {
    private readonly Interaction interaction = new ();

    private Task OnSubmit()
    {
        return InteractionService.Create(interaction);
    }

}