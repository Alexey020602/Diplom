@using Client.Services.Api
@using Microsoft.AspNetCore.Authorization
@using Model
@using Model.Divisions
@using Model.Interactions
@using Model.Partners
@using Client.Shared
@inherits Client.Shared.DetailPage<Interaction>
@page "/interactions/{id:int}"
@attribute [Authorize(Roles = "Cip")]
@{
    base.BuildRenderTree(__builder);
}

@code {
    [Inject] private IInteractionsService InteractionsService { get; set; } = null!;

    protected override Task<Interaction> LoadItem()
    {
        return InteractionsService.ReadOne(Id);
    }

    protected override RenderFragment? Header(Interaction item) => null;

    protected override IEnumerable<Row> Rows(Interaction item) =>
    [
        new("Тип", item.Type?.Name),
        new("Код", item.ContactCode),
        new("Тема", item.Theme),
        new("Дата подписания", item.SigningDate.ToShortDateString()),
        new("Дата начала", item.Begin.ToShortDateString()),
        new("Дата окончания", item.End.ToShortDateString()),
        new("Партнер", Partner(item.Partner)),
        new("Подразделение университета", Division(item.Division)),
        new("Направления", Directions(item)),
    ];

    private RenderFragment Partner(PartnerShort? partner) => @<div>
        @if (partner != null)
        {
            <NavLink href=@($"/{NavigationConstants.PartnersPath}/{partner.Id}")>@partner.Name</NavLink>
        }
    </div>;

    private RenderFragment Division(DivisionShort? division) => @<div>
        @if (division != null)
        {
            <NavLink href=@($"/{NavigationConstants.DivisionsPath}/{division.Id}")>@division</NavLink>
        }
    </div>;

    private RenderFragment Directions(Interaction interaction) => @<DirectionsList Directions="interaction.Directions"/>;

    protected override string? Title => "Информация о взаимодействии";
    protected override string EntitiesPath => "interactions";
    protected override Task Delete() => InteractionsService.Delete(Id);

}