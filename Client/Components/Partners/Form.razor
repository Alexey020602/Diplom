@using System.Collections.ObjectModel
@using Client.Services.Api
@using Client.Services.Api.BaseApi
@using Client.Shared.Select
@using Microsoft.AspNetCore.Authorization
@using Model
@using Model.Partners
@attribute [Authorize(Roles = "Ctt")]
@inherits Client.Shared.Form.BaseForm<Model.Partners.Partner>
@inject IReadApi<PartnerType> PartnerTypesApi
@{
    base.BuildRenderTree(__builder);
}

@code
{
    protected override RenderFragment Content =>
        @<RadzenStack Orientation=@Orientation.Vertical>
            @* <RadzenRow> *@
            @*     <RadzenColumn Size="3"> *@
            @*        Краткое название *@
            @*     </RadzenColumn> *@
            @*     <RadzenColumn Size="9"> *@
            @*         <RadzenTextBox Style="width: 100%" @bind-Value=@Item.ShortName Name="ShortName"/> *@
            @*     </RadzenColumn> *@
            @* </RadzenRow> *@
            @* <RadzenRow> *@
            @*     <RadzenColumn Size="3"> *@
            @*         Тип партнера *@
            @*     </RadzenColumn> *@
            @*     <RadzenColumn Size="9"> *@
            @*         <UniversalCustomSelect Style="width: 100%" *@
            @*             TItem=@PartnerType *@
            @*             LoadItems="@(() => PartnerTypesApi.ReadAll())" *@
            @*             @bind-Value=@Item.Type *@
            @*             Name="Type"/> *@
            @*     </RadzenColumn> *@
            @* </RadzenRow> *@
            @ShortName
            @FullName
            @Address
            @ContactData
            @City
            @Type
            @Directions
    </RadzenStack>;

    private RenderFragment ShortName => FormRow(
        "Краткое название",
        "ShortName",
        @<RadzenTextBox Style="width: 100%" @bind-Value=@Item.ShortName Name="ShortName"/>
    );

    private RenderFragment FullName => FormRow(
        "Полное название",
        "FullName",
        @<RadzenTextBox Style="width: 100%" @bind-Value=@Item.FullName Name="FullName"/>
    );

    private RenderFragment Address => FormRow(
        "Адрес",
        "Address",
        @<RadzenTextBox Style="width: 100%" @bind-Value=@Item.Address Name="Address"/>
    );

    private RenderFragment ContactData => FormRow(
        "Контактные данные",
        "ContactData",
        @<RadzenTextArea Style="width: 100%" @bind-Value=@Item.ContactData Name="ContactData"/>
    );

    private RenderFragment City => FormRow(
        "Город",
        "City",
        @<RadzenTextBox Style="width: 100%" @bind-Value=@Item.City Name="City"/>
    );

    private RenderFragment Type => FormRow(
        "Тип партнера",
        "Type",
        @<UniversalCustomSelect
             TItem=@PartnerType
             Style="width: 100%"
             LoadItems="@(() => PartnerTypesApi.ReadAll())"
             @bind-Value="Item.Type"
             Name="Type"/>
    );

    private RenderFragment Directions => FormRow(
        "Направления",
        "Directions",
        @<UniversalMultipleSelect
             TApi=@IDirectionsService
             TItem=@Direction             
             Style="width: 100%"
             @bind-Value=@Item.Directions
             Name="Directions"
             Multiple=true/>
    );
}