@attribute [Authorize(Roles = "Cip")]
@using Client.Services.Api.BaseApi
@using Microsoft.AspNetCore.Authorization
@using Client.Shared.Select
@using Model.Partners
@inherits Client.Shared.List.SearchableStyledList<Model.Partners.PartnerShort>

@page "/"
@page "/partners"

<PageTitle>Патнеры университета</PageTitle>
@{
    base.BuildRenderTree(__builder);
}

@code {
    protected override RenderFragment Filters =>
        @<UniversalSelect
             Placeholder="Выберите тип партнера"
             TItem=@PartnerType
             TApi="IReadApi<PartnerType>"
              @bind-Value=@PartnerType/>;

    protected override string Title => "Партнеры";
}